{
  "name": "clarity",
  "version": "1.1.0",
  "description": "A modern, open-source system cleaner for Windows, macOS, and Linux",
  "desktopName": "Clarity",
  "main": "./out/main/index.js",
  "author": "Clarity Contributors <clarity@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptainHacX/Clarity.git"
  },
  "homepage": "https://clarity.app",
  "bugs": {
    "url": "https://github.com/CaptainHacX/Clarity/issues"
  },
  "optionalDependencies": {
    "clarity-corewlan": "file:src/native/corewlan"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.0",
    "lucide-react": "^0.577.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "systeminformation": "^5.31.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.3.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-gyp": "^12.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "postinstall": "node scripts/build-native.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:rules": "tsx src/main/rules/validate.ts",
    "new-rule": "node scripts/new-rule.js",
    "find-cache": "node scripts/find-cache.js",
    "preview-rule": "node scripts/preview-rule.js",
    "parity-check": "node scripts/parity-check.js",
    "catalog": "node scripts/generate-catalog.js",
    "icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-builder --config electron-builder.yml",
    "release": "node scripts/release.js"
  },
  "overrides": {
    "fs-extra": "^11.3.0"
  }
}
